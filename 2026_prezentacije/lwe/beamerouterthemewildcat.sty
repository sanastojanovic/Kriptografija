\mode<presentation>

% Default for standalone usage (without beamerthemewildcat.sty)
\providecommand{\wc@numbering}{fraction}
\providecommand{\wc@breadcrumb}{on}

\makeatletter

% Ensure hyperref package is included
\usepackage{hyperref}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Set the frame title and footer
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Breadcrumb header and frame title
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Breadcrumb je sada poseban headline i prikazuje se
% čak i kada slajd nema \frametitle.
\setbeamertemplate{headline}{%
  \def\wc@tmp{none}%
  \ifx\wc@breadcrumb\wc@tmp
  \else
    \ifnum\value{section}>0\relax
    \nointerlineskip%
    \begin{beamercolorbox}[
      wd=\paperwidth,
      sep=0pt,
      leftskip=0.55cm,
      rightskip=0.55cm
    ]{frametitle}
      \vskip0.25cm%
        {%
        \tiny
        \color{wcprimary!20}%
        \MakeUppercase{\insertsectionhead}%
        \ifnum\value{subsection}>0\relax
        \space\space›\space\space
        \MakeUppercase{\insertsubsectionhead}%
        \fi
        \par
      }%
      \vskip0.08cm%
    \end{beamercolorbox}%
    \fi
  \fi
}

% Naslov slajda više ne sadrži breadcrumb.
\defbeamertemplate*{frametitle}{wildcat}[1][]
{
  \nointerlineskip%
  \begin{beamercolorbox}[
    wd=\paperwidth,
    sep=0pt,
    leftskip=0.55cm,
    rightskip=0.55cm,
    #1
  ]{frametitle}
    \vskip0.10cm%
      {%
      \usebeamerfont{frametitle}%
      \usebeamercolor[fg]{frametitle}%
      \insertframetitle\par
    }%
    \ifx\insertframesubtitle\@empty
    \else
        {%
        \usebeamerfont{framesubtitle}%
        \usebeamercolor[fg]{framesubtitle}%
        \insertframesubtitle\par
      }%
    \fi
    \vskip0.12cm%
  \end{beamercolorbox}%
}

